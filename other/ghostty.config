# Ghostty configuration
# Symlinked to ~/.config/ghostty/config by setup.zsh
# Docs: `ghostty +show-config --default --docs` or https://ghostty.org/docs/config

# Appearance
theme = Catppuccin Mocha

# Font (listed in fallback order; first match wins per glyph)
font-family = JetBrainsMono Nerd Font
font-family = JetBrains Mono
font-family = Hack Nerd Font
font-size = 12

# wezterm line_height = 1.05 -> add 5% to cell height
adjust-cell-height = 5%

# Window
background-opacity = 0.98
# wezterm "RESIZE" (no title bar, still resizable) -> closest GTK equivalent
window-padding-x = 8
window-padding-y = 8
# Hide the tab bar unless more than one tab is open
window-show-tab-bar = auto

# Behavior
scrollback-limit = 10000000
# Updates are handled by the system package manager on Fedora
auto-update = off
