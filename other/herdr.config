onboarding = false

[keys]
# Use Ctrl+s as prefix (matching tmux C-s)
prefix = "ctrl+s"

# --- Pane navigation (vim-style, from tmux prefix+hjkl) ---
focus_pane_left = "prefix+h"
focus_pane_down = "prefix+j"
focus_pane_up = "prefix+k"
focus_pane_right = "prefix+l"

# --- Pane cycling ---
cycle_pane_next = "prefix+tab"
cycle_pane_previous = "prefix+shift+tab"

# --- Tab switching (maps from tmux window switching) ---
new_tab = "prefix+c"
previous_tab = "prefix+p"
next_tab = "prefix+n"
switch_tab = "prefix+1..9"
rename_tab = "prefix+shift+t"
close_tab = "prefix+shift+x"

# --- Split & pane operations ---
split_vertical = "prefix+v"
split_horizontal = "prefix+minus"
close_pane = "prefix+x"
zoom = "prefix+z"
rename_pane = "prefix+shift+p"

# --- Resize mode (from tmux prefix+HJKL) ---
resize_mode = "prefix+r"

# --- Workspace operations ---
new_workspace = "prefix+shift+n"
rename_workspace = "prefix+shift+w"
close_workspace = "prefix+shift+d"

# --- Last pane (maps from tmux prefix+Space → last session) ---
last_pane = "prefix+comma"

# --- Settings / detach / help ---
help = "prefix+?"
settings = "prefix+s"
detach = "prefix+q"
reload_config = "prefix+shift+r"
toggle_sidebar = "prefix+b"

# --- Navigate mode shortcuts (tmux-style hjkl without prefix) ---
navigate_pane_left = "h"
navigate_pane_down = "j"
navigate_pane_up = "k"
navigate_pane_right = "l"

# --- Fuzzy pickers (herdr built-in, replaces tmux-fzf) ---
# workspace_picker = "prefix+w"   # Fuzzy-switch workspaces (like tmux-fzf session switch)
# goto     = "prefix+g"            # Fuzzy-jump to tabs, panes, or workspaces
